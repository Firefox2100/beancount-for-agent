#!/usr/bin/env bash
# Review and resolve what the agent proposed, through the REST API. For the user, never the agent:
# only the slash commands call it. Needs curl and jq.
#
#   review pending [LEDGER]        proposals waiting for approval, across ledgers
#   review show LEDGER ID          one proposal with its postings
#   review approve LEDGER ID       commit it
#   review reject LEDGER ID [NOTE] refuse it
#   review due [LEDGER]            what is due soon
#   review details LEDGER ACCOUNT [FIELD=VALUE ...] [-FIELD ...]
#                                  show an account's bank details in full, set fields, or
#                                  clear them with a leading dash. Run it in your own terminal:
#                                  anything typed into the chat is seen by the agent.
#
# Settings come from the environment or the token file, never from arguments:
#   BEANCOUNT_MCP_URL (default http://127.0.0.1:8000)
#   BEANCOUNT_MCP_AUTH_TOKEN, else the plugin's stored token (CLAUDE_PLUGIN_OPTION_API_TOKEN),
#   else the first line of BEANCOUNT_MCP_TOKEN_FILE
#   (default ~/.config/beancount-mcp/token)
set -u
url="${BEANCOUNT_MCP_URL:-${CLAUDE_PLUGIN_OPTION_URL:-http://127.0.0.1:8000}}"
url="${url%/}"
token="${BEANCOUNT_MCP_AUTH_TOKEN:-${CLAUDE_PLUGIN_OPTION_API_TOKEN:-}}"
if [ -z "$token" ]; then
  file="${BEANCOUNT_MCP_TOKEN_FILE:-$HOME/.config/beancount-mcp/token}"
  if [ -r "$file" ]; then
    token=$(sed -n 's/^BEANCOUNT_MCP_AUTH_TOKEN=//p' "$file" | head -n1 | tr -d '[:space:]')
    [ -n "$token" ] || token=$(grep -m1 -E '^[^#=[:space:]]+$' "$file" | tr -d '[:space:]')
  fi
fi

api() { # api METHOD PATH [JSON]: print the body, fail with the service's reason
  local method=$1 path=$2 body=${3:-} out status
  local args=(-sS --max-time 15 -X "$method" -H 'x-actor: user' -H 'x-client-id: claude-code-review' -w '\n%{http_code}')
  [ -n "$token" ] && args+=(-H "authorization: Bearer $token")
  [ -n "$body" ] && args+=(-H 'content-type: application/json' -d "$body")
  out=$(curl "${args[@]}" "$url$path") || { echo "cannot reach $url" >&2; return 1; }
  status=${out##*$'\n'}
  out=${out%$'\n'*}
  if [ "$status" -ge 400 ]; then
    echo "$status: $(jq -r '.detail | if type == "string" then . else tojson end' <<<"$out" 2>/dev/null || echo "$out")" >&2
    return 1
  fi
  printf '%s\n' "$out"
}

ledgers() { api GET /ledgers | jq -r '.[].id'; }

format() { # one proposal as reviewable text
  jq -r '
    def posting: "    \(.account)  \(if .units then "\(.units.number) \(.units.currency)" else "" end)\(if .price then " @ \(.price.number) \(.price.currency)" else "" end)";
    def op($i):
      if .kind == "add_transaction" or .kind == "update_transaction" then
        "\($i)\(if .kind == "add_transaction" then "add" else "update \(.id)" end): \([.transaction.date, .transaction.payee, .transaction.narration] | map(select(. != null and . != "")) | join(" "))",
        (.transaction.postings[] | "\($i)\(posting)")
      elif .kind == "batch" then (.operations[] | op($i + "  "))
      elif .kind == "open_account" then "\($i)open \(.account)\(if .type then " (\(.type))" else "" end)"
      elif .kind == "close_account" then "\($i)close \(.account)"
      elif .kind == "reconcile" then "\($i)reconcile \(.account) to \(.amount.number) \(.amount.currency) on \(.date)"
      else "\($i)\(.kind)" end;
    "\(.id)  [\(.ledger_id)]  \(.status)",
    "from \([.caller.actor, .caller.client_id] | map(select(. != null)) | join("/"))",
    (if .note then "note: \(.note)" else empty end),
    (.operation | op(""))'
}

case "${1:-}" in
  pending)
    ids=${2:-$(ledgers)} || exit 1
    found=0
    for ledger in $ids; do
      list=$(api GET "/ledgers/$ledger/changes?status=pending") || exit 1
      count=$(jq 'length' <<<"$list")
      [ "$count" -gt 0 ] || continue
      found=1
      jq -c 'sort_by(.created_at) | .[]' <<<"$list" | while read -r change; do
        format <<<"$change"
        echo
      done
    done
    [ "$found" = 1 ] || echo "nothing pending"
    ;;
  show)
    [ $# -ge 3 ] || { echo "usage: review show LEDGER ID" >&2; exit 2; }
    api GET "/ledgers/$2/changes/$3" | format
    ;;
  approve|reject)
    [ $# -ge 3 ] || { echo "usage: review $1 LEDGER ID [NOTE]" >&2; exit 2; }
    note="${*:4}"
    body=$(jq -nc --arg n "$note" '{note: (if $n == "" then null else $n end)}')
    result=$(api POST "/ledgers/$2/changes/$3/$1" "$body") || exit 1
    echo "$3: $(jq -r .status <<<"$result")"
    ;;
  due)
    ids=${2:-$(ledgers)} || exit 1
    for ledger in $ids; do
      api GET "/ledgers/$ledger/due?within_days=14" | jq -r --arg l "$ledger" '
        if length == 0 then "[\($l)] nothing due in 14 days"
        else .[] | "[\($l)] \(.account)  due \(.due_date // "?")  \(.owed | to_entries | map("\(.value) \(.key)") | join(", "))" end'
    done
    ;;
  details)
    [ $# -ge 3 ] || { echo "usage: review details LEDGER ACCOUNT [FIELD=VALUE ...] [-FIELD ...]" >&2; exit 2; }
    ledger=$2 account=$3
    shift 3
    if [ $# -eq 0 ]; then
      api GET "/ledgers/$ledger/accounts" | jq -r --arg a "$account" '
        (.[] | select(.name == $a)) // error("no such account")
        | .details | if length == 0 then "no details set" else to_entries[] | "\(.key): \(.value)" end'
      exit
    fi
    body=$(jq -nc '{set: {}, clear: []}')
    for arg in "$@"; do
      case "$arg" in
        -*) body=$(jq -c --arg f "${arg#-}" '.clear += [$f]' <<<"$body") ;;
        *=*) body=$(jq -c --arg f "${arg%%=*}" --arg v "${arg#*=}" '.set[$f] = $v' <<<"$body") ;;
        *) echo "expected FIELD=VALUE or -FIELD, got: $arg" >&2; exit 2 ;;
      esac
    done
    api PUT "/ledgers/$ledger/accounts/$account/details" "$body" >/dev/null || exit 1
    echo "saved"
    ;;
  *)
    sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 2
    ;;
esac
